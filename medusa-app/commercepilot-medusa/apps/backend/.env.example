# Copy to .env and fill in real local values. Never commit the real .env.
MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# Local docker-compose Redis (see medusa-app/docker-compose.yml)
REDIS_URL=redis://localhost:6381

# Generate your own local-only secrets, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-random-local-secret
COOKIE_SECRET=replace-with-a-random-local-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-string

# Local docker-compose Postgres (see medusa-app/docker-compose.yml)
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa_store

# HASEBHA AI service (FastAPI) -- see ../../../../commerce-pilot-ai/src/ai_service.
# Not started automatically alongside Medusa; run separately with:
#   uvicorn src.ai_service.main:app --port 8123 (from the commerce-pilot-ai repo root)
COMMERCEPILOT_AI_SERVICE_URL=http://localhost:8123
