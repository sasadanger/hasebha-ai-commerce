# Copy to .env.local and fill in real local values. Never commit the real .env.local.
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API keys are designed to be client-exposed (like a Stripe
# publishable key) -- not a secret -- but this value is specific to a
# given Medusa database instance. Get yours from Medusa Admin ->
# Settings -> Publishable API Keys after seeding, or via:
#   npx medusa exec ./src/migration-scripts/get-pub-key.ts
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_your_local_publishable_key

NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=eg
REVALIDATE_SECRET=replace-with-a-random-local-secret
